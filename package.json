{
  "name": "edukator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Подготовка к вступительным тестам в 7 класс: русский, английский, математика",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"EDUKATOR_WEB_DEV=1 tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "start:family": "concurrently -k -n server,family \"npm start\" \"npm run family:controller\"",
    "family:setup": "bash controller/bootstrap.sh",
    "family:login": "controller/.venv/bin/edukator-family-login",
    "family:controller": "controller/.venv/bin/edukator-family-controller",
    "family:test": "controller/.venv/bin/python -m pytest controller/tests",
    "extract-toc": "tsx scripts/extract-toc.ts",
    "build-curriculum": "tsx scripts/build-curriculum.ts",
    "prefetch": "tsx scripts/prefetch.ts",
    "parent": "tsx scripts/parent.ts",
    "backup": "tsx scripts/backup.ts",
    "adopt": "tsx scripts/adopt-single-user.ts",
    "test": "npm run build:web && vitest run",
    "test:e2e": "npm run build:web && playwright test",
    "coverage": "npm run build:web && vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "katex": "^0.18.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.4",
    "eslint": "^9.37.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
