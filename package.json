{
  "name": "edukator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Подготовка к вступительным тестам в 7 класс: русский, английский, математика",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "extract-toc": "tsx scripts/extract-toc.ts",
    "build-curriculum": "tsx scripts/build-curriculum.ts",
    "prefetch": "tsx scripts/prefetch.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.37.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
