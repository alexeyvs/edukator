{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edukator.local/schemas/curriculum.json",
  "title": "Карта тем курса",
  "description": "Содержимое одной legacy-карты курса. Имя файла не является идентификатором курса.",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "topics"],
  "properties": {
    "subject": {
      "description": "Непрозрачный идентификатор курса; overall зарезервирован для общего прогноза.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": { "const": "overall" }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "grade": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "title",
        "exam_weight",
        "difficulty",
        "prereqs",
        "answer_format",
        "prompt_seed"
      ],
      "properties": {
        "id": {
          "description": "Стабильный идентификатор вида <subject>.<тема>; на него ссылаются topic_state, задания и попытки.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.[a-z0-9-]+$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "not": { "const": "overall" }
        },
        "title": {
          "description": "Название обычными словами: попадает в дашборд родителей.",
          "type": "string",
          "minLength": 1
        },
        "exam_weight": {
          "description": "0-3, вероятность встретиться на вступительном. Главный рычаг приоритизации.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "difficulty": {
          "description": "1-3, базовая сложность темы.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "prereqs": {
          "description": "Темы, которые должны быть освоены раньше. Только id тем того же предмета.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.[a-z0-9-]+$"
          }
        },
        "answer_format": {
          "description": "Определяет ветвь нормализатора ответа.",
          "enum": ["number", "text", "choice"]
        },
        "prompt_seed": {
          "description": "Как генерировать задания по теме, с примерами формулировок.",
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
