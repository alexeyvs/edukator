{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edukator.local/schemas/integrity-review.json",
  "title": "Проверка осмысленности ответов",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "confidence", "reason"],
        "properties": {
          "id": { "type": "integer" },
          "decision": { "enum": ["meaningful", "doubtful", "junk"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
