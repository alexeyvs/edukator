{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edukator.local/schemas/learning-material.json",
  "title": "Персональный учебный материал",
  "description": "Структурированный материал на 10–15 минут без HTML. Ограничения количества и длины проверяет server/codex/learning-material-schema.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["introduction", "objectives", "sections", "summary"],
  "properties": {
    "introduction": {
      "description": "Короткое введение: зачем тема нужна и какую ошибку поможет исправить.",
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "description": "От одной до трёх конкретных целей материала.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "sections": {
      "description": "От трёх до пяти последовательных разделов.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/section" }
    },
    "summary": {
      "description": "Итоговая памятка из двух–пяти коротких пунктов.",
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "blocks": {
          "description": "Безопасные блоки раздела; HTML запрещён, formula содержит display-LaTeX без разделителей $.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["paragraph", "formula", "example", "warning"]
        },
        "content": { "type": "string", "minLength": 1 }
      }
    }
  }
}
