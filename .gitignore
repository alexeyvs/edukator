node_modules/
# Каталог данных по умолчанию: control.db и базы детей. Данных ученика в
# репозитории быть не должно.
data/
*.db
*.db-wal
*.db-shm
.env
content/cache/
coverage/
playwright-report/
test-results/
web/dist/
.tmp/
controller/.venv/
controller/build/
*.egg-info/
__pycache__/
*.pyc
# `writeFileAtomic` кладёт временный файл рядом с целевым, то есть внутри
# отслеживаемых `content/`. Оборванная запись (Ctrl-C, кончившееся место) убрать
# его уже некому, а `.tmp/` со слешем — это каталог, файлы им не покрываются.
*.tmp
